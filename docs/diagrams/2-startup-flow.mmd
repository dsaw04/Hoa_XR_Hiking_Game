%%{init: {"flowchart": {"nodeSpacing": 40, "rankSpacing": 40}}}%%
flowchart TD
  A(["App launch"]) --> B["HikingPlayerController.Start"]
  B --> C["SpawnOnTrail<br/>place rig on the circular trail"]
  C --> D{"Editor and<br/>no XR device?"}
  D -- yes --> E["Attach DesktopHikeSimulator<br/>keyboard + mouse stand-in"]
  D -- no --> F["MovementModeManager.GetOrCreate"]
  E --> F
  F --> G{"Confirmed<br/>this launch?"}
  G -- yes --> Z["BeginSession"]
  G -- no --> H["Lock locomotion<br/>show BodyCheckInUI"]
  H --> I["Player affirms<br/>mode · intensity · duration"]
  I --> J["ConfirmSession<br/>save to PlayerPrefs"]
  J --> K(["OnSessionConfirmed event"])
  K --> Z
  Z --> L["ApplyMovementMode<br/>scale reach · effort · speed · pace"]
  L --> M(["Spawn L / R orbs<br/>unlock locomotion"])

  classDef gate fill:#d6ebef,stroke:#2f96ac,color:#0c4652,stroke-width:1.5px;
  classDef term fill:#f6e4c8,stroke:#c9974a,color:#5a3f16,stroke-width:1.5px;
  class D,G gate;
